# Copie ce fichier en .env.local et remplis les valeurs.

# Mot de passe pour accéder à l'appli (choisis-en un solide)
APP_PASSWORD=

# Supabase : Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude : https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Sources d'offres (au moins une ; les autres sont ignorées si vides)
# La Bonne Alternance : https://api.apprentissage.beta.gouv.fr (compte > jetons d'accès)
LBA_API_TOKEN=
# France Travail : https://francetravail.io (application avec l'API "Offres d'emploi v2")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Envoi des candidatures depuis ton Gmail (mot de passe d'application :
# https://myaccount.google.com/apppasswords, la validation en 2 étapes doit être active)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Secret de la tâche planifiée Vercel (n'importe quelle longue chaîne aléatoire)
CRON_SECRET=
